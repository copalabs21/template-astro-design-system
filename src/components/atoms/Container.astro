---
interface Props {
  size?: "sm" | "md" | "lg" | "xl" | "full";
  class?: string;
}

const { size = "lg", class: className } = Astro.props;

const sizes = {
  sm: "max-w-2xl",
  md: "max-w-4xl",
  lg: "max-w-6xl",
  xl: "max-w-7xl",
  full: "max-w-none",
} as const;
---

<div class:list={["mx-auto w-full px-4 md:px-6", sizes[size], className]}>
  <slot />
</div>
