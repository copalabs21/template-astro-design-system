---
interface Props {
  src?: string;
  alt?: string;
  fallback?: string;
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { src, alt = "", fallback, size = "md", class: className } = Astro.props;

const sizes = {
  sm: "size-8 text-xs",
  md: "size-10 text-sm",
  lg: "size-14 text-base",
} as const;
---

<span
  class:list={[
    "inline-flex items-center justify-center overflow-hidden rounded-full bg-muted font-medium text-muted-foreground",
    sizes[size],
    className,
  ]}
>
  {
    src ? (
      <img src={src} alt={alt} class="size-full object-cover" />
    ) : (
      <span aria-hidden="true">{fallback}</span>
    )
  }
</span>
