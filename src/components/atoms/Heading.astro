---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag = "h2"> = Polymorphic<{ as: Tag }> & {
  size?: "sm" | "md" | "lg" | "xl" | "2xl" | "3xl" | "4xl";
};

const { as: Tag = "h2", size = "xl", class: className, ...rest } = Astro.props;

const sizes = {
  sm: "text-lg",
  md: "text-xl",
  lg: "text-2xl",
  xl: "text-3xl",
  "2xl": "text-4xl",
  "3xl": "text-5xl",
  "4xl": "text-6xl",
} as const;
---

<Tag
  class:list={[
    "font-sans font-semibold tracking-tight text-balance text-foreground",
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
