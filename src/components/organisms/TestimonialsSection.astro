---
import Container from "@/components/atoms/Container.astro";
import Testimonial from "@/components/molecules/Testimonial.astro";

interface Item {
  quote: string;
  name: string;
  role?: string;
  avatarSrc?: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<section class:list={["py-16 md:py-24", className]}>
  <Container size="lg">
    <div class="grid gap-6 md:grid-cols-3">
      {items.map((item) => <Testimonial {...item} />)}
    </div>
  </Container>
</section>
