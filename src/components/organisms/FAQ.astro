---
import Container from "@/components/atoms/Container.astro";
import Eyebrow from "@/components/atoms/Eyebrow.astro";
import Heading from "@/components/atoms/Heading.astro";
import FaqItem from "@/components/molecules/FaqItem.astro";

interface Item {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: Item[];
  class?: string;
}

const { eyebrow, heading, items, class: className } = Astro.props;
---

<section class:list={["py-16 md:py-24", className]}>
  <Container size="md">
    <div class="max-w-2xl space-y-4">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <Heading as="h2" size="2xl">
        {heading}
      </Heading>
    </div>
    <div class="mt-10 border-t border-border">
      {items.map((item) => <FaqItem question={item.question}>{item.answer}</FaqItem>)}
    </div>
  </Container>
</section>
