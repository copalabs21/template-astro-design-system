---
import Container from "@/components/atoms/Container.astro";
import Eyebrow from "@/components/atoms/Eyebrow.astro";
import Heading from "@/components/atoms/Heading.astro";
import ProcessStep from "@/components/molecules/ProcessStep.astro";

interface Item {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: Item[];
  class?: string;
}

const { eyebrow, heading, items, class: className } = Astro.props;
---

<section class:list={["py-16 md:py-24", className]}>
  <Container size="lg">
    <div class="max-w-2xl space-y-4">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <Heading as="h2" size="2xl">
        {heading}
      </Heading>
    </div>
    <div class="mt-10 grid gap-8 border-t border-border pt-10 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item, i) => <ProcessStep index={i + 1} title={item.title}>{item.description}</ProcessStep>)}
    </div>
  </Container>
</section>
