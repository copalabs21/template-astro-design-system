---
import Container from "@/components/atoms/Container.astro";
import Button from "@/components/atoms/Button.astro";
import BrandMark from "@/components/atoms/BrandMark.astro";
import NavLink from "@/components/molecules/NavLink.astro";
import ThemeToggle from "@/components/molecules/ThemeToggle.astro";

interface NavItem {
  label: string;
  href: string;
  active?: boolean;
}

interface Props {
  nav?: NavItem[];
  ctaLabel?: string;
  ctaHref?: string;
  class?: string;
}

const { nav = [], ctaLabel, ctaHref, class: className } = Astro.props;

const hasLogo = Astro.slots.has("logo");
---

<header class:list={["relative border-b border-border bg-background", className]}>
  <Container size="xl">
    <div class="flex h-16 items-center justify-between">
      {
        hasLogo ? (
          <slot name="logo" />
        ) : (
          <a href="/" class="flex items-center gap-2 font-semibold text-foreground">
            <BrandMark size="sm" />
            <span>Site Name</span>
          </a>
        )
      }

      <div class="flex items-center gap-4">
        <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
          {nav.map((item) => (
            <NavLink href={item.href} active={item.active}>
              {item.label}
            </NavLink>
          ))}
          {ctaLabel && ctaHref && (
            <Button as="a" href={ctaHref} size="sm">
              {ctaLabel}
            </Button>
          )}
        </nav>

        <ThemeToggle />

        <details class="md:hidden">
          <summary
            class="list-none cursor-pointer rounded-md p-2 text-foreground hover:bg-muted"
            aria-label="Toggle menu"
          >
            <span aria-hidden="true">&#9776;</span>
          </summary>
          <nav
            class="absolute inset-x-0 top-16 z-10 border-b border-border bg-background p-4"
            aria-label="Mobile"
          >
            <div class="flex flex-col gap-4">
              {nav.map((item) => (
                <NavLink href={item.href} active={item.active}>
                  {item.label}
                </NavLink>
              ))}
              {ctaLabel && ctaHref && (
                <Button as="a" href={ctaHref} size="sm">
                  {ctaLabel}
                </Button>
              )}
            </div>
          </nav>
        </details>
      </div>
    </div>
  </Container>
</header>
