---
import Container from "@/components/atoms/Container.astro";
import FeatureItem from "@/components/molecules/FeatureItem.astro";

interface Item {
  title: string;
  description: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<section class:list={["py-16 md:py-24", className]}>
  <Container size="lg">
    <div class="motion-cards grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <FeatureItem title={item.title}>{item.description}</FeatureItem>
        ))
      }
    </div>
  </Container>
</section>
