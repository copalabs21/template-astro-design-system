---
interface Props {
  variant?: "info" | "success" | "warning" | "danger";
  title?: string;
  class?: string;
}

const { variant = "info", title, class: className } = Astro.props;

const variants = {
  info: "border-border bg-secondary text-secondary-foreground",
  success: "border-success/30 bg-success/10 text-success",
  warning: "border-warning/30 bg-warning/10 text-warning",
  danger: "border-danger/30 bg-danger/10 text-danger",
} as const;

const hasIcon = Astro.slots.has("icon");
---

<div
  class:list={["flex gap-3 rounded-md border p-4 text-sm", variants[variant], className]}
  role="alert"
>
  {hasIcon && <div class="shrink-0"><slot name="icon" /></div>}
  <div class="space-y-1">
    {title && <p class="font-medium">{title}</p>}
    <div><slot /></div>
  </div>
</div>
