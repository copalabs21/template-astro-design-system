---
interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={["text-sm text-muted-foreground", className]}>
  <ol class="flex items-center gap-2">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {item.href && i !== items.length - 1 ? (
            <a href={item.href} class="transition-colors hover:text-foreground">
              {item.label}
            </a>
          ) : (
            <span class="text-foreground" aria-current="page">
              {item.label}
            </span>
          )}
          {i !== items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
